# Copy to .env.local and fill the values. Never commit .env.local.
# Only VITE_* values reach the browser bundle; they are public by design (Supabase anon key + URL).

# Supabase project used by the web app (local dev: printed by `supabase start`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# App metadata shown on the About screen and sent with every sync batch
VITE_APP_ENV=development

# ---- Mac-only tools (tools/ospos-import). NEVER used by the web app or CI build. ----
# Put these in tools/ospos-import/.env.local, not here.
# TARGET_SUPABASE_URL=
# TARGET_SUPABASE_SERVICE_ROLE_KEY=
# OSPOS_EXPORT_FILE=migration-data/ospos-export-YYYY-MM-DD.json
# OSPOS_IMAGES_BASE_URL=https://hanafy.home.kg/public/
