"<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title></title><style>
@page { size: 80mm auto; margin: 0; }
* { box-sizing: border-box; }
html, body { width: 72mm; margin: 0; padding: 0; background: #fff; color: #000; }
body { font-family: Cairo, Tahoma, Arial, sans-serif; font-size: 11pt; line-height: 1.35; font-variant-numeric: tabular-nums; }
.center { text-align: center; }
.shop { font-size: 14pt; font-weight: 700; }
.small { font-size: 9pt; }
.banner { margin: 2mm auto; padding: 1mm 4mm; border: 0.5mm solid #000; display: block; width: max-content; font-weight: 700; font-size: 13pt; }
.rule { border: 0; border-top: 0.3mm dashed #000; margin: 2mm 0; }
.row { display: flex; justify-content: space-between; gap: 2mm; }
.line { margin-bottom: 1.5mm; }
.name { font-weight: 600; overflow-wrap: anywhere; }
.num { direction: ltr; unicode-bidi: plaintext; white-space: nowrap; }
.total { font-size: 16pt; font-weight: 700; }
.barcode { display: block; width: 100%; height: 12mm; margin: 1mm 0; }
.id { direction: ltr; text-align: center; font-size: 9pt; }
.no-print { display: none; }
@media print { .no-print { display: none; } }
</style></head><body><div dir="rtl"><div class="center shop">مركز حنفي</div><div class="banner">قفل الوردية (Z)</div><div class="id">K1-SHF-000001</div><div class="row small"><span>الكاشير: عبدالله</span></div><div class="row small"><span class="num">10/10/2026 09:00</span><span class="num">10/10/2026 23:00</span></div><hr class="rule"/><div class="row"><span>رصيد أول الوردية</span><span class="num">100.00</span></div><div class="name">المبيعات</div><div class="row"><span>نقدي</span><span class="num">15.00</span></div><div class="row"><span>فيزا</span><span class="num">5.00</span></div><div class="row" style="font-weight:700"><span>إجمالي المبيعات</span><span class="num">20.00</span></div><div class="row"><span>مرتجعات (0)</span><span class="num">0.00</span></div><div class="name">تحصيلات</div><div class="row"><span>مصروفات</span><span class="num">5.00</span></div><div class="row"><span>توريد للخزنة</span><span class="num">0.00</span></div><div class="row"><span>فتح الدرج بدون بيع</span><span class="num">1</span></div><div class="row"><span>فواتير ملغية</span><span class="num">0</span></div><hr class="rule"/><div class="row" style="font-weight:700"><span>المتوقع في الدرج</span><span class="num">110.00</span></div><div class="row" style="font-weight:700"><span>المعدود</span><span class="num">109.00</span></div><div class="row total"><span>الفرق</span><span class="num">-1.00</span></div></div></body></html>"
