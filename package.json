{
  "name": "hardware-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src tools",
    "test:related": "vitest related --run",
    "test:int": "vitest run tests/int --no-file-parallelism --testTimeout=600000 --passWithNoTests",
    "e2e:smoke": "playwright test --grep @smoke --project=chromium --project=firefox",
    "e2e": "playwright test",
    "perf": "PERF=1 playwright test --project=perf",
    "test:int:fresh": "supabase db reset --yes && npm run test:int",
    "import": "node tools/ospos-import/index.ts",
    "test:agent": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "perf:seed": "docker exec -i $(docker ps -qf name=supabase_db_hardware-erp) psql -U postgres < supabase/perf/seed_volume.sql",
    "perf:explain": "docker exec -i $(docker ps -qf name=supabase_db_hardware-erp) psql -U postgres < supabase/perf/explain.sql > perf-results/db.txt 2>&1 && cat perf-results/db.txt",
    "perf:screens": "PERF=1 playwright test --project=perf tests/perf/screens.spec.ts",
    "perf:profile": "PERF=1 playwright test --project=perf tests/perf/profile.spec.ts"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "e2e": "0.19.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "360 kB",
      "gzip": true
    }
  ],
  "overrides": {
    "uuid": "^11.1.1",
    "e2e": {
      "zod": "$zod"
    }
  }
}
