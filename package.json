{
  "name": "hardware-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src tools",
    "test:related": "vitest related --run",
    "test:int": "vitest run tests/int --no-file-parallelism --testTimeout=600000 --passWithNoTests",
    "e2e:smoke": "playwright test --grep @smoke --project=chromium --project=firefox",
    "e2e": "playwright test",
    "perf": "echo \"perf: added in phase 9\"",
    "device:add": "node tools/device-admin/add-device.mjs",
    "test:int:fresh": "supabase db reset --yes && npm run test:int",
    "import": "node tools/ospos-import/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "size-limit": "^14.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "350 kB",
      "gzip": true
    }
  ]
}
